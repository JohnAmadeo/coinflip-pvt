{
    "name": "coinflip/coinflip-pvt",
    "description": "A simple coin flip library with deterministic randomness support",
    "type": "library",
    "license": "ISC",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Coinflip\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Coinflip\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
